{
  "name": "dsh-pnl-attribution",
  "version": "0.1.0",
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "description": "Floating A-share P&L card for DeepSeek Harness that ranks today's per-holding contribution and exports a presentation-ready closing-summary PNG.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "stock",
    "a-share",
    "portfolio",
    "pnl",
    "attribution"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-pnl-attribution.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-pnl-attribution#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-pnl-attribution/issues"
  },
  "license": "MIT"
}
